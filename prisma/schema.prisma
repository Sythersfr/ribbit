// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopCredential {
  shop                  String   @id
  apiKey                String   @unique
  camProductGid         String?
  camVariantNumeric     String?
  guardProductGid       String?
  guardVariantNumeric   String?
  sellingPlanGid        String?
  sellingPlanNumeric    String?
  createdAt             DateTime @default(now())
}

model CompanionPlan {
  id           String     @id @default(cuid())
  shop         String
  name         String
  handle       String
  priceCents   Int
  interval     String     @default("month")
  seats        Int        @default(3)
  featuresJson String     @default("[\"ai_alerts\",\"multi_cam\"]")
  productGid   String?
  createdAt    DateTime   @default(now())
  contracts    Contract[]

  @@unique([shop, handle])
}

model Contract {
  id            String        @id @default(cuid())
  shop          String
  shopifyOrderId String?      @unique
  licenseKey    String        @unique
  email         String
  status        String        @default("active")
  planId        String
  plan          CompanionPlan @relation(fields: [planId], references: [id])
  productGid    String?
  productTitle  String?
  seatsIncluded Int
  seatsUsed     Int           @default(1)
  periodEnd     DateTime
  createdAt     DateTime      @default(now())
}

model GeneratedApp {
  id        String   @id @default(cuid())
  shop      String
  slug      String   @unique
  name      String
  prompt    String
  specJson  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, createdAt])
}
